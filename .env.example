# Copy to .env (git-ignored) and edit: cp .env.example .env
# make run / make test-db load it. Write KEY=value with no quotes and no spaces
# around "=". A value set here beats one exported in your shell; to override it
# for one run, pass it to make instead: make run LISTEN_ADDR=:8099

# Postgres from docker-compose.yml (make db-up).
DATABASE_URL=postgres://ds:ds@localhost:5433/ds?sslmode=disable
TEST_DATABASE_URL=postgres://ds:ds@localhost:5433/ds_test?sslmode=disable

# Everything below is optional; the values shown are the defaults.
# LISTEN_ADDR=:8080
# MAPS_DIR=./maps
# START_MAP=kumotori_1
# TICK_RATE=10
# MOVE_SPEED_TILES=4
# AOI_CELL_SIZE=10
# ZONE_CAPACITY=50
# SAVE_INTERVAL=60s
# REGISTER_PER_HOUR=5
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
# LOG_LEVEL=info
